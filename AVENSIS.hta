<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=iso-8859-1">
<title>AVENSIS</title>
<HTA:APPLICATION
  ID="AvensisManual"
  APPLICATIONNAME="AVENSIS Manual"
  BORDER="thin"
  CAPTION="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  WINDOWSTATE="maximize"
  SCROLL="no"
  NAVIGABLE="yes"
  INNERBORDER="no"
  CONTEXTMENU="yes"
  SELECTION="yes"
  MINIMIZEBUTTON="yes"
  MAXIMIZEBUTTON="yes"
/>
</head>
<!-- Same shell as contents/index3.html. application=yes keeps ActiveX inside the IE host. -->
<frameset rows="33,*" border="0" framespacing="0">
  <frameset cols="260,*" border="0" framespacing="0">
    <frame application="yes" src="contents/menu_top.html" frameborder="0" scrolling="no" noresize>
    <frame application="yes" src="contents/top.html" scrolling="no" frameborder="0" name="top" noresize>
  </frameset>
  <frameset cols="260,*" border="0" framespacing="0">
    <frameset rows="*,33" border="0" framespacing="0">
      <frame application="yes" src="contents/menu_tree.html" nowrap scrolling="auto" name="menu_tree" marginheight="0" marginwidth="0">
      <frame application="yes" src="contents/menu_search.html" scrolling="no" name="menu_search" frameborder="0">
    </frameset>
    <frameset rows="*,0" border="0" framespacing="0">
      <frame application="yes" src="contents/pdf.html" scrolling="no" name="pdf" frameborder="0" noresize>
      <frame application="yes" src="contents/frameopen.html" scrolling="no" name="frameopen" frameborder="0" noresize>
    </frameset>
  </frameset>
</frameset>
</html>
